{
    "manifest_version": 3,
    "name": "UAT-PROD Switcher",
    "description": "Toggle between your production and UAT sites with one click or a keyboard shortcut, keeping the page you're on.",
    "version": "2.0.0",
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "images/icon16.png",
        "32": "images/icon32.png",
        "48": "images/icon48.png",
        "128": "images/icon128.png"
    },
    "action": {
        "default_title": "UAT-PROD Switcher"
    },
    "options_page": "options.html",
    "permissions": [
        "activeTab",
        "scripting",
        "tabs",
        "storage"
    ],
    "optional_host_permissions": [
        "*://*/*"
    ],
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Alt+Shift+U",
                "mac": "Alt+Shift+U"
            }
        }
    }
}
